# ─── Supabase (cliente) ───────────────────────────────────────────────
# Copia este archivo a apps/web/.env.local y rellena con `supabase start` (local) o el panel (prod).
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key-de-supabase-start>"

# ─── Supabase (solo servidor / Edge Functions) ───────────────────────
# NUNCA exponer al cliente. Usado por submit-score para INSERT con service_role.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# ─── Servicio de annealing (OpenJij) ─────────────────────────────────
# URL del microservicio Python; lo consume la Edge Function `anneal`.
ANNEAL_SERVICE_URL="http://127.0.0.1:8000"
# Token compartido Edge -> Python (además del JWT de usuario).
ANNEAL_SERVICE_TOKEN="<token-interno>"
