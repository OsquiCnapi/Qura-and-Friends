# Secrets de las Edge Functions (Deno). En local los usa `supabase functions serve`.
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY se inyectan automáticamente por Supabase.
# Solo hay que definir los del servicio de annealing:
ANNEAL_SERVICE_URL="http://host.docker.internal:8000"
ANNEAL_SERVICE_TOKEN="<token-interno-compartido>"
